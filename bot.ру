@dp.message(CreateBotFSM.waiting_for_token)
async def process_bot_token(message: Message, state: FSMContext):
    token = message.text.strip()
    if message.text == "/cancel":
        await state.clear()
        await message.answer("❌ Отменено.", reply_markup=get_main_kb(message.from_user.id))
        return

    # Базовая валидация токена регулярным выражением
    if not re.match(r"^\d{8,10}:[a-zA-Z0-9_-]{35}$", token):
        await message.answer("❌ <b>Неверный формат токена.</b>\nТокен должен выглядеть примерно так: `1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ`\n\nПопробуйте еще раз или напишите /cancel")
        return
        
    await message.answer("⏳ Проверяем токен и запускаем бота...")
    
    # Сохраняем в БД
    if db_add_child_bot(message.from_user.id, token):
        # Запускаем параллельно
        asyncio.create_task(launch_child_bot(token, message.from_user.id))
        await message.answer("✅ <b>Успешно!</b>\nВаш бот запущен и готов к работе. Зайдите в него и нажмите /start.", reply_markup=get_main_kb(message.from_user.id))
    else:
        await message.answer("❌ Этот токен уже используется в нашей системе.", reply_markup=get_main_kb(message.from_user.id))
    
    await state.clear()

