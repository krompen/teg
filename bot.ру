@dp.message(CreateBotFSM.waiting_for_token)
async def process_new_bot_token(message: Message, state: FSMContext):
    token = message.text.strip()
    if token == "/cancel":
        await state.clear()
        return await message.answer("❌ Отменено.", reply_markup=get_main_kb(message.from_user.id))

    if not re.match(r"^\d{8,10}:[a-zA-Z0-9_-]{35}$", token):
        return await message.answer("❌ <b>Неверный формат токена.</b> Попробуйте еще раз или /cancel")
        
    await message.answer("⏳ Проверяем и запускаем...")
    if db_add_child_bot(message.from_user.id, token):
        asyncio.create_task(launch_child_bot(token, message.from_user.id))
        await message.answer("✅ <b>Ваш бот успешно запущен!</b>\nПерейдите в него и нажмите /start.", reply_markup=get_main_kb(message.from_user.id))
    else:
        await message.answer("❌ У вас уже есть бот, либо этот токен занят.")
    await state.clear()

@dp.callback_query(F.data.in_(["set_bio", "set_hours", "toggle_spam", "delete_bot"]))
async def bot_settings_handler(call: CallbackQuery, state: FSMContext):
    user_id = call.from_user.id
    db_user = db_get_user(user_id)
    is_premium = db_user[4] == 1
    action = call.data

    if action == "delete_bot":
        db_delete_child_bot(user_id)
        # Примечание: физически процесс бота остановится при рестарте сервера, но из БД он удален.
        await call.message.edit_text("✅ Бот удален из базы. (Окончательная остановка произойдет при перезагрузке системы).")
        return

    if not is_premium:
        return await call.answer("💎 Эта функция доступна только с Premium!", show_alert=True)

    if action == "set_bio":
        await call.message.answer("✏️ <b>Отправьте новое описание (Bio):</b>\nНапример: Что вы продаете/покупаете, ваши услуги.")
        await state.set_state(BotSettingsFSM.waiting_for_bio)
    elif action == "set_hours":
        await call.message.answer("🕒 <b>Отправьте часы работы:</b>\nНапример: Пн-Пт 10:00-20:00")
        await state.set_state(BotSettingsFSM.waiting_for_hours)
    elif action == "toggle_spam":
        bot_data = db_get_child_bot(user_id)
        new_val = 0 if bot_data[4] == 1 else 1
        db_update_child_bot(user_id, "spam_filter", new_val)
        await call.message.edit_text(f"✅ Антиспам фильтр {'включен' if new_val else 'выключен'}.")
    await call.answer()

