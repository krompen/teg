# === ОБРАБОТКА ТЕКСТА ===
@bot.on_message(filters.private & filters.text)
async def handle_text(client, message):
    user_id = message.from_user.id
    
    # 1. Проверка капчи
    if user_id in captcha_states:
        try:
            answer = int(message.text)
            if answer == captcha_states[user_id]:
                del captcha_states[user_id]
                await update_user(user_id, "status", "pending")
                await message.reply("✅ Капча пройдена. Заявка отправлена администратору. Ожидайте.")
                
                # Уведомляем админа
                admin_kb = InlineKeyboardMarkup([
                    [InlineKeyboardButton("✅ Одобрить", callback_data=f"approve_{user_id}"),
                     InlineKeyboardButton("❌ Отклонить", callback_data=f"reject_{user_id}")]
                ])
                user_link = f"[{message.from_user.first_name}](tg://user?id={user_id})"
                await bot.send_message(ADMIN_ID, f"🔔 **Новая заявка!**\nПользователь: {user_link} (`{user_id}`)\nХочет использовать бота.", reply_markup=admin_kb)
            else:
                await message.reply("❌ Неверно, попробуйте еще раз.")
        except ValueError:
            await message.reply("❌ Пожалуйста, отправьте только число.")
        return

    if user_id not in auth_steps: return
    step = auth_steps[user_id].get("step")
    
    if user_id == ADMIN_ID and step.startswith("admin_"):
        if step == "admin_broadcast":
            users = await get_all_users_detailed()
            count = 0
            for u in users:
                if u[3] == "approved":
                    try:
                        await client.send_message(u[0], message.text)
                        count += 1; await asyncio.sleep(0.05)
                    except: pass
            await message.reply(f"✅ Разослано: {count} пользователям.")
        elif step == "admin_get_id":
            try:
                user = await client.get_users(message.text)
                await message.reply(f"ID: `{user.id}`")
            except: await message.reply("❌ Не найдено.")
        del auth_steps[user_id]; return

    if step == "ar_text":
        await update_user(user_id, "auto_reply_text", message.text)
        del auth_steps[user_id]
        await message.reply("✅ Текст обновлен!", reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 В меню", callback_data="start")]]))
        return

    if step == "phone":
        phone = message.text.replace(" ", "").replace("+", "")
        msg = await message.reply("⏳ Запрос кода...")
        user_client = Client(f"user_{user_id}", api_id=API_ID, api_hash=API_HASH)
        await user_client.connect()
        try:
            code_info = await user_client.send_code(phone)
            auth_steps[user_id] = {"step": "code", "client": user_client, "phone": phone, "hash": code_info.phone_code_hash}
            await msg.edit_text("📩 Введите код через пробел:")
        except Exception as e:
            await msg.edit_text(f"❌ Ошибка: {e}")
            del auth_steps[user_id]
            
    elif step == "code":
        code = message.text.replace(" ", "").replace("-", "")
        data = auth_steps[user_id]
        user_client = data["client"]
        msg = await message.reply("⏳ Проверяю...")
        try:
            await user_client.sign_in(data["phone"], data["hash"], code)
            await user_client.disconnect()
            await update_user(user_id, "is_connected", 1)
            del auth_steps[user_id]
            await msg.edit_text("✅ Успешно!")
            await start_userbot(user_id)
        except SessionPasswordNeeded:
            auth_steps[user_id]["step"] = "password"
            await msg.edit_text("🔐 Введите 2FA пароль:")
        except Exception as e:
            await msg.edit_text(f"❌ Ошибка: {e}")
            del auth_steps[user_id]
            
    elif step == "password":
        user_client = auth_steps[user_id]["client"]
        msg = await message.reply("⏳ Проверяю пароль...")
        try:
            await user_client.check_password(message.text)
            await user_client.disconnect()
            await update_user(user_id, "is_connected", 1)
            del auth_steps[user_id]
            await msg.edit_text("✅ Успешно!")
            await start_userbot(user_id)
        except Exception as e:
            await msg.edit_text(f"❌ Ошибка: {e}")
            del auth_steps[user_id]

async def load_sessions():
    users = await get_all_users_detailed()
    for u in users:
        if u[1] == 1 and u[3] == "approved" and os.path.exists(f"user_{u[0]}.session"):
            await start_userbot(u[0])

async def main():
    await init_db()
    await bot.start()
    await load_sessions()
    print(f"🤖 Бот запущен!")
    while True: await asyncio.sleep(3600)

if __name__ == "__main__":
    loop = asyncio.get_event_loop()
    loop.run_until_complete(main())
