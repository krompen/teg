        def get_watermark():
            owner = db_get_user(owner_id)
            is_premium = owner[4] == 1 if owner else False
            return "" if is_premium else f"\n\n⚡️ <i>Создано в @{MAIN_BOT_USERNAME}</i>"

        @child_dp.message(CommandStart())
        async def child_start(message: Message, state: FSMContext):
            await state.clear()
            text = (f"👋 <b>Здравствуйте!</b>\n\n"
                    f"Это бот для прямой связи со мной. Воспользуйтесь меню ниже.{get_watermark()}")
            await message.answer(text, reply_markup=get_child_kb())

        @child_dp.message(F.text == "👤 Мой профиль")
        async def child_profile(message: Message):
            text = (f"👤 <b>Ваш профиль:</b>\n\n"
                    f"<b>Имя:</b> {message.from_user.full_name}\n"
                    f"<b>ID:</b> <code>{message.from_user.id}</code>")
            await message.answer(text)

        @child_dp.message(F.text == "ℹ️ Инфо о владельце")
        async def child_info(message: Message):
            bot_data = db_get_child_bot(owner_id)
            if not bot_data: return await message.answer("❌ Информация не найдена.")
            text = (f"ℹ️ <b>Информация:</b>\n\n"
                    f"<b>Услуги/Товары:</b>\n{bot_data[2]}\n\n"
                    f"🕒 <b>Часы работы:</b> {bot_data[3]}")
            await message.answer(text)

        @child_dp.message(Command("reply"))
        async def child_owner_reply(message: Message):
            if message.from_user.id != owner_id: return
            args = message.text.split(maxsplit=2)
            if len(args) < 3:
                return await message.answer("ℹ️ <b>Используйте:</b> <code>/reply [ID] [Текст ответа]</code>")
            
            try:
                wm = get_watermark()
                await child_bot.send_message(int(args[1]), f"📩 <b>Ответ владельца:</b>\n\n{args[2]}{wm}")
                await message.answer(f"✅ Отправлено пользователю <code>{args[1]}</code>.")
            except Exception as e:
                await message.answer(f"❌ Ошибка отправки: {e}")

        @child_dp.message(F.text == "✉️ Написать владельцу")
        async def child_contact(message: Message, state: FSMContext):
            await message.answer("Выберите категорию:", reply_markup=get_categories_kb(prefix="ch_cat_"))
            await state.set_state(ChildBotStates.choosing_category)

        @child_dp.callback_query(F.data.startswith("ch_cat_"), ChildBotStates.choosing_category)
        async def child_cat_chosen(call: CallbackQuery, state: FSMContext):
            if call.data == "ch_cat_cancel":
                await state.clear()
                return await call.message.edit_text("❌ Отменено.")
            cats = {"ch_cat_question": "❓ Вопрос", "ch_cat_problem": "⚠️ Проблема", "ch_cat_collab": "🤝 Сотрудничество", "ch_cat_idea": "💡 Идея"}
            cat = cats.get(call.data, "Другое")
            await state.update_data(category=cat)
            await call.message.edit_text(f"Категория: <b>{cat}</b>\n\n✏️ Напишите ваше сообщение:")
            await state.set_state(ChildBotStates.writing_message)

        @child_dp.message(ChildBotStates.writing_message)
        async def child_receive(message: Message, state: FSMContext):
            bot_data = db_get_child_bot(owner_id)
            
            # Антиспам проверка
            if bot_data and bot_data[4] == 1 and len(message.text) < 15:
                return await message.answer("❌ Включен антиспам. Сообщение слишком короткое (мин. 15 символов).")

            data = await state.get_data()
            user = message.from_user
            username = f"@{user.username}" if user.username else "Скрыт"
            
            admin_text = (f"🔔 <b>Новое обращение!</b>\n"
                          f"<b>Категория:</b> {data.get('category')}\n"
                          f"<b>От:</b> {user.full_name} ({username})\n"
                          f"<b>ID:</b> <code>{user.id}</code>\n\n"
                          f"{message.text}\n\n"
                          f"<i>Для ответа:</i> <code>/reply {user.id} Ваш текст</code>")
            try:
                await child_bot.send_message(owner_id, admin_text)
                await message.answer(f"✅ <b>Отправлено!</b>{get_watermark()}", reply_markup=get_child_kb())
            except Exception:
                await message.answer("❌ Ошибка. Владелец заблокировал бота.")
            await state.clear()

        logging.info(f"Дочерний бот (ID владельца {owner_id}) запущен.")
        await child_dp.start_polling(child_bot)
        
    except Exception as e:
        logging.error(f"Ошибка запуска бота владельца {owner_id}: {e}")

async def main():
    init_db()
    
    global MAIN_BOT_USERNAME
    try:
        me = await bot.get_me()
        MAIN_BOT_USERNAME = me.username
    except Exception:
        logging.error("Неверный токен основного бота!")
        return

    logging.info(f"Старт основы: @{MAIN_BOT_USERNAME}")
    
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("SELECT bot_token, owner_id FROM child_bots")
    child_bots = c.fetchall()
    conn.close()
    
    for b_token, b_owner in child_bots:
        asyncio.create_task(launch_child_bot(b_token, b_owner))
        
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
