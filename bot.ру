@bot.on_message(filters.private & filters.text)
async def handle_text(client, message):
    user_id = message.from_user.id
    
    # --- АДМИН ДЕЙСТВИЯ ---
    if user_id == ADMIN_ID and user_id in auth_steps and auth_steps[user_id].get("admin_action"):
        action = auth_steps[user_id]["admin_action"]
        text = message.text
        
        if action == "broadcast":
            users = await get_all_users()
            count = 0
            await message.reply("⏳ Начинаю рассылку...")
            for u in users:
                try:
                    await client.send_message(u, text)
                    count += 1
                    await asyncio.sleep(0.05)
                except: pass
            del auth_steps[user_id]
            return await message.reply(f"✅ Рассылка завершена. Доставлено: {count}")
            
        elif action == "ban":
            target = int(text)
            await update_user(target, "is_banned", 1)
            del auth_steps[user_id]
            return await message.reply(f"✅ Пользователь {target} забанен.")
            
        elif action == "prem":
            try:
                target_id, days = map(int, text.split())
                prem_time = int(time.time()) + (days * 86400)
                await update_user(target_id, "premium_until", prem_time)
                del auth_steps[user_id]
                await client.send_message(target_id, f"🎉 Администратор выдал вам Premium на {days} дней!")
                return await message.reply(f"✅ Премиум выдан пользователю {target_id} на {days} дней.")
            except:
                return await message.reply("❌ Ошибка формата. Нужно: `ID ДНИ`")
                
        elif action == "get_id":
            try:
                user = await client.get_users(text)
                del auth_steps[user_id]
                return await message.reply(f"🔍 ID пользователя {text}: `{user.id}`")
            except Exception as e:
                return await message.reply(f"❌ Пользователь не найден: {e}")

    # --- ЛОГИКА АВТОРИЗАЦИИ ЮЗЕРБОТА ---
    if user_id in auth_steps:
        step = auth_steps[user_id].get("step")
        
        if step == "phone":
            phone = message.text.replace(" ", "").replace("+", "")
            msg = await message.reply("⏳ Отправляю запрос кода...")
            user_client = Client(f"temp_{user_id}", api_id=API_ID, api_hash=API_HASH, in_memory=True)
            await user_client.connect()
            try:
                code_info = await user_client.send_code(phone)
                auth_steps[user_id] = {
                    "step": "code",
                    "client": user_client,
                    "phone": phone,
                    "phone_code_hash": code_info.phone_code_hash
                }
                await msg.edit_text("📩 Код отправлен в ваш Telegram. Введите его **через пробел** или с дефисами (например: `1 2 3 4 5`), чтобы Telegram не удалил сообщение:")
            except Exception as e:
                await msg.edit_text(f"❌ Ошибка: {e}")
                del auth_steps[user_id]
                
        elif step == "code":
            code = message.text.replace(" ", "").replace("-", "")
            data = auth_steps[user_id]
            user_client = data["client"]
            msg = await message.reply("⏳ Проверяю код...")
            try:
                await user_client.sign_in(data["phone"], data["phone_code_hash"], code)
                session = await user_client.export_session_string()
                await update_user(user_id, "session_string", session)
                await user_client.disconnect()
                del auth_steps[user_id]
                await msg.edit_text("✅ Авторизация успешна! Запускаю вашего личного помощника...")
                await start_userbot(user_id, session)
            except SessionPasswordNeeded:
                auth_steps[user_id]["step"] = "password"
                await msg.edit_text("🔐 На аккаунте стоит 2FA пароль (Облачный пароль). Введите его:")
            except Exception as e:
                await msg.edit_text(f"❌ Ошибка кода: {e}")
                del auth_steps[user_id]
                
        elif step == "password":
            data = auth_steps[user_id]
            user_client = data["client"]
            msg = await message.reply("⏳ Проверяю пароль...")
            try:
                await user_client.check_password(message.text)
                session = await user_client.export_session_string()
                await update_user(user_id, "session_string", session)
                await user_client.disconnect()
                del auth_steps[user_id]
                await msg.edit_text("✅ Авторизация успешна! Запускаю вашего личного помощника...")
                await start_userbot(user_id, session)
            except Exception as e:
                await msg.edit_text(f"❌ Неверный пароль: {e}")
                del auth_steps[user_id]

