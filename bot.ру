# === ЛОГИКА ЮЗЕРБОТА ===
async def start_userbot(user_id):
    if user_id in active_userbots: return True
    
    # Используем файловую сессию (создаст user_ID.session) для решения проблемы с Peer ID
    client = Client(f"user_{user_id}", api_id=API_ID, api_hash=API_HASH)
    
    @client.on_message(filters.private & ~filters.bot)
    async def handle_incoming(c, m):
        if not m.from_user: return
        
        # 1. Автоответчик (отвечаем только если пишут нам, а не мы сами)
        if not m.from_user.is_self:
            user_data = await get_user(user_id)
            if user_data and user_data[4]: # auto_reply_on
                try:
                    await m.reply(user_data[3]) # auto_reply_text
                except: pass

        # 2. Кэширование для удаленок/измененок
        if m.text or m.caption:
            key = f"{user_id}_{m.id}"
            msg_cache[key] = {
                "text": m.text or m.caption,
                "sender": m.from_user.first_name or "Неизвестный",
                "is_me": m.from_user.is_self
            }
            cache_queue.append(key)

    @client.on_edited_message(filters.private & ~filters.bot)
    async def catch_edit(c, m):
        key = f"{user_id}_{m.id}"
        if key not in msg_cache: return
        
        old_data = msg_cache[key]
        if old_data["is_me"]: return # Не логируем свои изменения
        
        new_text = m.text or m.caption
        if old_data["text"] == new_text: return
        
        msg_cache[key]["text"] = new_text # Обновляем кэш
        user_link = f"@{m.from_user.username}" if m.from_user.username else old_data["sender"]
        
        text = (f"✏️ **Изменено сообщение**\n{user_link}\n\n"
                f"**Старый текст:** ⏳ {old_data['text']}\n"
                f"**Новый текст:** 🦋 {new_text}\n"
                f"[Перейти в чат]({m.link})")
        try:
            await bot.send_message(user_id, text, disable_web_page_preview=True)
        except: pass

    @client.on_deleted_messages()
    async def catch_delete(c, messages):
        for m in messages:
            key = f"{user_id}_{m.id}"
            if key in msg_cache:
                data = msg_cache.pop(key)
                if data["is_me"]: continue # Игнорируем удаление наших собственных сообщений
                
                text = f"🗑 **Удалено сообщение в ЛС**\nОт: **{data['sender']}**\n\n**Текст:** {data['text']}"
                try:
                    await bot.send_message(user_id, text)
                except: pass

    try:
        await client.start()
        active_userbots[user_id] = client
        
        # Обновление био
        try:
            me = await client.get_me()
            current_bio = me.bio or ""
            if "swithub" not in current_bio.lower():
                new_bio = current_bio + " | @swithub_robot"
                if len(new_bio) <= 70:
                    await client.update_profile(bio=new_bio)
        except Exception as e:
            print(f"Не удалось обновить био {user_id}: {e}")
            
        return True
    except Exception as e:
        print(f"Ошибка запуска юзербота {user_id}: {e}")
        await update_user(user_id, "is_connected", 0)
        return False

