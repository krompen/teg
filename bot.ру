# --- СИСТЕМА ДОЧЕРНИХ БОТОВ (SaaS) ---
async def launch_child_bot(token: str, owner_id: int):
    """Изолированно запускает пользовательского бота (клиента)."""
    try:
        child_bot = Bot(token=token, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
        child_dp = Dispatcher()
        
        def get_child_kb():
            return ReplyKeyboardMarkup(keyboard=[[KeyboardButton(text="✉️ Написать владельцу")]], resize_keyboard=True)
            
        @child_dp.message(CommandStart())
        async def child_start(message: Message, state: FSMContext):
            await state.clear()
            text = (f"👋 <b>Привет!</b>\n\n"
                    f"Я бот для связи с моим владельцем. Нажми кнопку ниже, чтобы отправить ему сообщение.\n\n"
                    f"⚡️ <i>Создано с помощью @{MAIN_BOT_USERNAME}</i>")
            await message.answer(text, reply_markup=get_child_kb())

        class ChildContact(StatesGroup):
            writing = State()

        @child_dp.message(F.text == "✉️ Написать владельцу")
        async def child_contact(message: Message, state: FSMContext):
            await message.answer("✏️ Напишите ваше сообщение (одним текстом):")
            await state.set_state(ChildContact.writing)

        @child_dp.message(ChildContact.writing)
        async def child_receive(message: Message, state: FSMContext):
            user = message.from_user
            username = f"@{user.username}" if user.username else "Скрыт"
            
            admin_text = (f"🔔 <b>Новое обращение из вашего бота!</b>\n\n"
                          f"<b>От кого:</b> {user.full_name} ({username})\n"
                          f"<b>ID:</b> <code>{user.id}</code>\n"
                          f"<b>Сообщение:</b>\n{message.text}\n\n"
                          f"<i>(Для ответа просто напишите пользователю в ЛС по юзернейму или используйте функционал Telegram)</i>")
            try:
                await child_bot.send_message(owner_id, admin_text)
                await message.answer(f"✅ <b>Сообщение доставлено!</b>\n\n⚡️ <i>Создано в @{MAIN_BOT_USERNAME}</i>", 
                                     reply_markup=get_child_kb())
            except Exception:
                await message.answer("❌ Ошибка при отправке. Возможно, владелец заблокировал бота.")
            await state.clear()

        logging.info(f"Запущен дочерний бот для владельца ID {owner_id}")
        await child_dp.start_polling(child_bot)
        
    except Exception as e:
        logging.error(f"Ошибка запуска дочернего бота {token[:10]}... : {e}")

# --- ЗАПУСК ПРОЕКТА ---
async def main():
    init_db()
    
    global MAIN_BOT_USERNAME
    try:
        me = await bot.get_me()
        MAIN_BOT_USERNAME = me.username
    except Exception as e:
        logging.error("Не удалось подключиться к главному боту. Проверьте TOKEN.")
        return

    logging.info(f"Старт основного бота: @{MAIN_BOT_USERNAME}")
    
    # Поднимаем всех ботов из базы данных
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("SELECT bot_token, owner_id FROM child_bots")
    child_bots = c.fetchall()
    conn.close()
    
    for b_token, b_owner in child_bots:
        # Запускаем каждого бота как отдельную фоновую задачу
        asyncio.create_task(launch_child_bot(b_token, b_owner))
        
    # Запуск поллинга главного бота
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
