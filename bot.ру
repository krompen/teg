@bot.on_message(filters.command("ban") & filters.private)
async def ban_cmd(client, message):
    if message.from_user.id != ADMIN_ID: return
    try:
        target = int(message.command[1])
        await update_user(target, "status", "banned")
        if target in active_userbots:
            await active_userbots[target].stop()
            del active_userbots[target]
            await update_user(target, "is_connected", 0)
        await message.reply(f"✅ Пользователь {target} заблокирован.")
    except: await message.reply("❌ Использование: `/ban ID`")

