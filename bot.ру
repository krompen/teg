# ==================== ДВИЖОК ЗЕРКАЛ (КАСТОМИЗАЦИЯ И ОП) ====================
async def launch_child_bot(token: str, owner_id: int):
    child_bot = Bot(token=token, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
    child_bot_instances[owner_id] = child_bot
    try:
        child_dp = Dispatcher(storage=MemoryStorage())

        def get_child_kb(user_id, bot_data):
            if user_id == owner_id:
                return ReplyKeyboardMarkup(keyboard=[
                    [KeyboardButton(text="⚙️ Настройки"), KeyboardButton(text="🎨 Оформление")],
                    [KeyboardButton(text="📊 Статистика"), KeyboardButton(text="📢 Рассылка")],
                ], resize_keyboard=True)
            # Пользовательские названия кнопок
            btn_contact = bot_data.get('btn_contact', '✉️ Написать')
            return ReplyKeyboardMarkup(keyboard=[
                [KeyboardButton(text=btn_contact), KeyboardButton(text="ℹ️ Подробнее")],
            ], resize_keyboard=True)

        async def check_mirror_sub(handler, event, data):
            user = event.from_user
            if not user or user.id == owner_id: return await handler(event, data)
            
            bot_data = await db_get_child_bot(owner_id)
            req_chan = bot_data.get('req_channel')
            if req_chan:
                sub = await is_subscribed_to_channel(user.id, req_chan)
                if sub is False:
                    kb = InlineKeyboardMarkup(inline_keyboard=[[InlineKeyboardButton(text="🔗 Подписаться", url=f"https://t.me/{req_chan.lstrip('@')}")]])
                    msg = "🔒 <b>Для использования бота подпишитесь на канал.</b>"
                    if isinstance(event, Message): await event.answer(msg, reply_markup=kb)
                    else: await event.answer("Нужна подписка", show_alert=True)
                    return
            return await handler(event, data)
            
        child_dp.message.outer_middleware(check_mirror_sub)

        @child_dp.message(CommandStart())
        async def child_start(message: Message):
            bot_data = await db_get_child_bot(owner_id)
            if message.from_user.id == owner_id:
                await message.answer("👋 Режим владельца активен.", reply_markup=get_child_kb(owner_id, bot_data))
            else:
                await message.answer(bot_data['start_text'], reply_markup=get_child_kb(message.from_user.id, bot_data))

        @child_dp.message(F.text == "🎨 Оформление")
        async def ch_design(message: Message, state: FSMContext):
            if message.from_user.id != owner_id: return
            kb = InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="📝 Текст при /start", callback_data="set_start_txt")],
                [InlineKeyboardButton(text="🔘 Текст кнопки связи", callback_data="set_btn_txt")],
                [InlineKeyboardButton(text="📢 Обязательная подписка", callback_data="set_req_chan")],
                [InlineKeyboardButton(text="📚 Подробно о себе", callback_data="set_ext_info")]
            ])
            await message.answer("🎨 <b>Кастомизация зеркала</b>\nВыберите, что хотите изменить:", reply_markup=kb)

        @child_dp.callback_query(F.data.startswith("set_"))
        async def ch_design_cb(call: CallbackQuery, state: FSMContext):
            if call.from_user.id != owner_id: return
            action = call.data
            prompts = {
                "set_start_txt": ("Текст при /start", "wait_start_txt"),
                "set_btn_txt": ("Текст кнопки связи (например, 'Связаться')", "wait_btn_txt"),
                "set_req_chan": ("Юзернейм канала для обязательной подписки (например, @mychannel) или 'off' для отключения", "wait_req_chan"),
                "set_ext_info": ("Подробная информация о вас (услуги, ссылки, прайс)", "wait_ext_info"),
            }
            if action in prompts:
                await call.message.answer(f"Отправьте новое значение для: <b>{prompts[action][0]}</b>")
                await state.set_state(prompts[action][1])
            await call.answer()

        @child_dp.message(StateFilter("wait_start_txt", "wait_btn_txt", "wait_req_chan", "wait_ext_info"))
        async def ch_save_design(message: Message, state: FSMContext):
            st = await state.get_state()
            val = message.text.strip()
            if st == "wait_start_txt": await db_update_child_bot(owner_id, "start_text", val)
            elif st == "wait_btn_txt": await db_update_child_bot(owner_id, "btn_contact", val[:30])
            elif st == "wait_req_chan": await db_update_child_bot(owner_id, "req_channel", "" if val.lower() == "off" else val)
            elif st == "wait_ext_info": await db_update_child_bot(owner_id, "extended_info", val)
            
            await message.answer("✅ Сохранено!")
            await state.clear()

        @child_dp.message(F.text == "ℹ️ Подробнее")
        async def ch_details(message: Message):
            bot_data = await db_get_child_bot(owner_id)
            await message.answer(f"ℹ️ <b>Информация:</b>\n\n{bot_data['extended_info']}")

        # Дальнейшая логика пересылки сообщений аналогична[span_1](start_span)[span_1](end_span)...

        await child_dp.start_polling(child_bot, handle_signals=False)
    except Exception as e:
        logger.error(f"Ошибка в боте {owner_id}: {e}")
