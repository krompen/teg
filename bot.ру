    if os.path.exists(f"user_{user_id}.session"):
        os.remove(f"user_{user_id}.session")
    await call.message.edit_text("🛑 Аккаунт отключен.", reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 В меню", callback_data="start")]]))

