# --- БАЗА ДАННЫХ ---
def init_db():
    """Инициализация таблиц базы данных."""
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    # Таблица пользователей (добавлено поле premium)
    c.execute('''
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY,
            username TEXT,
            full_name TEXT,
            is_banned INTEGER DEFAULT 0,
            premium INTEGER DEFAULT 0
        )
    ''')
    # Таблица дочерних ботов клиентов
    c.execute('''
        CREATE TABLE IF NOT EXISTS child_bots (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            owner_id INTEGER,
            bot_token TEXT UNIQUE
        )
    ''')
    conn.commit()
    conn.close()

def db_add_user(user_id, username, full_name):
    """Добавление пользователя. Возвращает True, если юзер новый."""
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("SELECT id FROM users WHERE id=?", (user_id,))
    exists = c.fetchone()
    
    if not exists:
        c.execute("INSERT INTO users (id, username, full_name, is_banned, premium) VALUES (?, ?, ?, 0, 0)",
                  (user_id, username, full_name))
        is_new = True
    else:
        c.execute("UPDATE users SET username=?, full_name=? WHERE id=?", (username, full_name, user_id))
        is_new = False
        
    conn.commit()
    conn.close()
    return is_new

def db_get_user(user_id):
    """Получение информации о пользователе."""
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("SELECT id, username, full_name, is_banned, premium FROM users WHERE id=?", (user_id,))
    user = c.fetchone()
    conn.close()
    return user

def db_apply_promo_if_available(user_id):
    """Выдает премиум, если лимит акции еще не исчерпан."""
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("SELECT COUNT(*) FROM users WHERE premium=1")
    premium_count = c.fetchone()[0]
    
    if premium_count < PROMO_LIMIT:
        c.execute("UPDATE users SET premium=1 WHERE id=?", (user_id,))
        conn.commit()
        conn.close()
        return True
    
    conn.close()
    return False

def db_set_status(user_id, field: str, value: int):
    """Изменение статуса (бан или премиум)."""
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute(f"UPDATE users SET {field}=? WHERE id=?", (value, user_id))
    conn.commit()
    conn.close()

def db_get_all_users():
    """Получение всех пользователей (для рассылки)."""
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("SELECT id FROM users")
    users = c.fetchall()
    conn.close()
    return [u[0] for u in users]

def db_add_child_bot(owner_id, token):
    """Сохранение токена клиентского бота."""
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    try:
        c.execute("INSERT INTO child_bots (owner_id, bot_token) VALUES (?, ?)", (owner_id, token))
        conn.commit()
        success = True
    except sqlite3.IntegrityError:
        success = False # Токен уже есть в базе
    finally:
        conn.close()
    return success

