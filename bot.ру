@bot.on_message(filters.private & filters.text)
async def handle_text(client, message):
    user_id = message.from_user.id
    
    if user_id in auth_steps:
        step = auth_steps[user_id].get("step")
        
        if step == "ar_text":
            await update_user(user_id, "auto_reply_text", message.text)
            del auth_steps[user_id]
            await message.reply("✅ Текст автоответчика обновлен!", reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 В меню", callback_data="start")]]))
            return

        if step == "phone":
            phone = message.text.replace(" ", "").replace("+", "")
            msg = await message.reply("⏳ Запрос кода...")
            user_client = Client(f"temp_{user_id}", api_id=API_ID, api_hash=API_HASH, in_memory=True)
            await user_client.connect()
            try:
                code_info = await user_client.send_code(phone)
                auth_steps[user_id] = {"step": "code", "client": user_client, "phone": phone, "hash": code_info.phone_code_hash}
                await msg.edit_text("📩 Введите код через пробел (например: `1 2 3 4 5`):")
            except Exception as e:
                await msg.edit_text(f"❌ Ошибка: {e}")
                del auth_steps[user_id]
                
        elif step == "code":
            code = message.text.replace(" ", "").replace("-", "")
            data = auth_steps[user_id]
            user_client = data["client"]
            msg = await message.reply("⏳ Проверяю...")
            try:
                await user_client.sign_in(data["phone"], data["hash"], code)
                session = await user_client.export_session_string()
                await update_user(user_id, "session_string", session)
                await user_client.disconnect()
                del auth_steps[user_id]
                await msg.edit_text("✅ Успешно!")
                await start_userbot(user_id, session)
            except SessionPasswordNeeded:
                auth_steps[user_id]["step"] = "password"
                await msg.edit_text("🔐 Введите 2FA пароль:")
            except Exception as e:
                await msg.edit_text(f"❌ Ошибка: {e}")
                del auth_steps[user_id]
                
        elif step == "password":
            user_client = auth_steps[user_id]["client"]
            msg = await message.reply("⏳ Проверяю пароль...")
            try:
                await user_client.check_password(message.text)
                session = await user_client.export_session_string()
                await update_user(user_id, "session_string", session)
                await user_client.disconnect()
                del auth_steps[user_id]
                await msg.edit_text("✅ Успешно!")
                await start_userbot(user_id, session)
            except Exception as e:
                await msg.edit_text(f"❌ Ошибка: {e}")
                del auth_steps[user_id]

async def load_sessions():
    async with aiosqlite.connect("database.db") as db:
        async with db.execute("SELECT user_id, session_string FROM users WHERE session_string IS NOT NULL") as cursor:
            for row in await cursor.fetchall():
                await start_userbot(row[0], row[1])

async def main():
    await init_db()
    await bot.start()
    await load_sessions()
    print("🤖 Бот запущен без паники!")
    while True: await asyncio.sleep(3600)

if __name__ == "__main__":
    loop = asyncio.get_event_loop()
    loop.run_until_complete(main())
