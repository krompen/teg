@dp.message(CommandStart(), StateFilter(any_state))
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()
    args = message.text.split()
    ref_id = int(args[1]) if len(args) > 1 and args[1].isdigit() else 0
    if ref_id == message.from_user.id: ref_id = 0
    
    await db_add_user(message.from_user.id, message.from_user.username, message.from_user.full_name, ref_id)
    text = (
        f"👋 <b>Привет, {esc(message.from_user.full_name)}!</b>\n\n"
        f"Создай своего личного бота для общения с аудиторией в 2 клика.\n"
        f"Никакого программирования — просто отправь токен и пользуйся."
    )
    await message.answer(text, reply_markup=get_main_kb(message.from_user.id))

