def init_db():
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    # Таблица пользователей
    c.execute('''
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY,
            username TEXT,
            full_name TEXT,
            is_banned INTEGER DEFAULT 0,
            premium INTEGER DEFAULT 0
        )
    ''')
    # Таблица ботов клиентов (связь 1 к 1)
    c.execute('''
        CREATE TABLE IF NOT EXISTS child_bots (
            owner_id INTEGER PRIMARY KEY,
            bot_token TEXT UNIQUE,
            bio TEXT DEFAULT 'Информация отсутствует.',
            working_hours TEXT DEFAULT 'Не указаны',
            spam_filter INTEGER DEFAULT 0
        )
    ''')
    
    # Миграция: если таблица старая, добавляем новые столбцы
    try: c.execute("ALTER TABLE child_bots ADD COLUMN bio TEXT DEFAULT 'Информация отсутствует.'")
    except: pass
    try: c.execute("ALTER TABLE child_bots ADD COLUMN working_hours TEXT DEFAULT 'Не указаны'")
    except: pass
    try: c.execute("ALTER TABLE child_bots ADD COLUMN spam_filter INTEGER DEFAULT 0")
    except: pass
    
    conn.commit()
    conn.close()

def db_add_user(user_id, username, full_name):
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("SELECT id FROM users WHERE id=?", (user_id,))
    if not c.fetchone():
        c.execute("INSERT INTO users (id, username, full_name, is_banned, premium) VALUES (?, ?, ?, 0, 0)", (user_id, username, full_name))
        is_new = True
    else:
        c.execute("UPDATE users SET username=?, full_name=? WHERE id=?", (username, full_name, user_id))
        is_new = False
    conn.commit()
    conn.close()
    return is_new

def db_get_user(user_id):
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("SELECT * FROM users WHERE id=?", (user_id,))
    user = c.fetchone()
    conn.close()
    return user

def db_apply_promo_if_available(user_id):
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("SELECT COUNT(*) FROM users WHERE premium=1")
    count = c.fetchone()[0]
    if count < PROMO_LIMIT:
        c.execute("UPDATE users SET premium=1 WHERE id=?", (user_id,))
        conn.commit()
        conn.close()
        return True
    conn.close()
    return False

def db_set_status(user_id, field, value):
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute(f"UPDATE users SET {field}=? WHERE id=?", (value, user_id))
    conn.commit()
    conn.close()

def db_add_child_bot(owner_id, token):
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    try:
        c.execute("INSERT INTO child_bots (owner_id, bot_token) VALUES (?, ?)", (owner_id, token))
        conn.commit()
        success = True
    except sqlite3.IntegrityError:
        success = False
    conn.close()
    return success

def db_get_child_bot(owner_id):
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("SELECT * FROM child_bots WHERE owner_id=?", (owner_id,))
    bot = c.fetchone()
    conn.close()
    return bot

def db_update_child_bot(owner_id, field, value):
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute(f"UPDATE child_bots SET {field}=? WHERE owner_id=?", (value, owner_id))
    conn.commit()
    conn.close()

def db_delete_child_bot(owner_id):
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("DELETE FROM child_bots WHERE owner_id=?", (owner_id,))
    conn.commit()
    conn.close()

