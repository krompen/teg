async def start_userbot(user_id, session_string):
    if user_id in active_userbots:
        return True
    
    client = Client(f"user_{user_id}", session_string=session_string, in_memory=True)
    
    # Слушаем ТОЛЬКО личные чаты (private)
    @client.on_message(filters.private & ~filters.me)
    async def handle_incoming(c, m):
        # 1. Автоответчик
        user_data = await get_user(user_id)
        if user_data and user_data[4]: # auto_reply_on == 1
            try:
                await m.reply(user_data[3]) # auto_reply_text
            except: pass

        # 2. Сохранение в кэш
        if m.text or m.caption:
            text = m.text or m.caption
            msg_cache[m.id] = text
            cache_queue.append(m.id)

    @client.on_edited_message(filters.private & ~filters.me)
    async def catch_edit(c, m):
        old_text = msg_cache.get(m.id, "Неизвестно (не было в кэше)")
        new_text = m.text or m.caption
        if old_text == new_text: return
        
        msg_cache[m.id] = new_text
        user_link = f"@{m.from_user.username}" if m.from_user and m.from_user.username else m.from_user.first_name if m.from_user else "Неизвестный"
        
        text = (f"✏️ **Изменено сообщение пользователя**\n{user_link}\n\n"
                f"**Старый текст:** ⏳ {old_text}\n"
                f"**Новый текст:** 🦋 {new_text}\n"
                f"[Перейти в чат]({m.link})")
        try:
            await bot.send_message(user_id, text, disable_web_page_preview=True)
        except: pass

    @client.on_deleted_messages()
    async def catch_delete(c, messages):
        for m in messages:
            if m.id in msg_cache:
                deleted_text = msg_cache.pop(m.id)
                text = f"🗑 **Удалено сообщение в ЛС**\n\n**Текст:** {deleted_text}"
                try:
                    await bot.send_message(user_id, text)
                except: pass

    try:
        await client.start()
        active_userbots[user_id] = client
        
        # Обновление био (в блоке try-except, чтобы не крашило при ошибке)
        try:
            me = await client.get_me()
            current_bio = me.bio or ""
            new_bio = current_bio + " | user @swithub_robot"
            if len(new_bio) <= 70 and "swithub" not in current_bio.lower():
                await client.update_profile(bio=new_bio)
        except Exception as e:
            print(f"Не удалось обновить био для {user_id}: {e}")
            
        await bot.send_message(user_id, "✅ Аккаунт успешно подключен! Слушаю личные сообщения.")
        return True
    except Exception as e:
        print(f"Ошибка запуска юзербота {user_id}: {e}")
        await update_user(user_id, "session_string", None)
        return False

