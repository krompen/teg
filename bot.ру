    await call.message.edit_text("Отправь ID пользователя, чтобы выдать Премиум:", reply_markup=cancel_kb())
    await state.set_state(AdminStates.wait_for_premium)

@dp.message(AdminStates.wait_for_premium)
async def process_premium(message: Message, state: FSMContext):
    try:
        uid = int(message.text)
        update_user(uid, "is_premium", 1)
        await message.answer(f"✅ Премиум успешно выдан пользователю {uid}!")
        await bot.send_message(uid, "🎉 Администратор выдал вам **Premium** доступ!", parse_mode="Markdown")
    except ValueError:
        await message.answer("❌ Ошибка. ID должен быть числом.")
    await state.clear()

