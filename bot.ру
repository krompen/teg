@dp.callback_query(F.data == "search_random")
async def search_random(call: CallbackQuery):
    await call.message.edit_text("⏳ Генерирую и проверяю юзернеймы... Это займет пару секунд.")
    found = []
    # Лимит для обычных пользователей — 5 проверок за раз, чтобы не получить бан от Telegram API
    for _ in range(5):
        uname = generate_readable_username(random.randint(5, 7))
        if await check_username_availability(uname):
            found.append(f"@{uname}")
        await asyncio.sleep(0.5) # Задержка от флуда
    
    if found:
        text = "🎉 **Свободные юзернеймы:**\n\n" + "\n".join(found)
    else:
        text = "😔 Ничего не найдено. Попробуй еще раз!"
        
    await call.message.edit_text(text, parse_mode="Markdown", reply_markup=search_menu_kb())

@dp.callback_query(F.data == "search_filter")
async def search_filter(call: CallbackQuery, state: FSMContext):
    user_data = get_user(call.from_user.id)
    if not user_data[0]:
        return await call.answer("Доступно только с Premium!", show_alert=True)
    
    await call.message.edit_text(
        "Отправь маску для поиска.\nНапример: `a?b?c?` (где ? - любая буква).",
        parse_mode="Markdown", reply_markup=cancel_kb()
    )
    await state.set_state(UserStates.wait_for_filter)

@dp.message(UserStates.wait_for_filter)
async def process_filter(message: Message, state: FSMContext):
    mask = message.text.lower()
    await message.answer("⏳ Ищу по фильтру... (имитация поиска)", reply_markup=cancel_kb())
    await state.clear()
    # Здесь логика генерации по маске
    await asyncio.sleep(2)
    await message.answer(f"🎉 Сгенерирован свободный юзернейм по маске:\n\n@{mask.replace('?', 'x')} (пример)", 
                         reply_markup=main_menu_kb(message.from_user.id == ADMIN_ID))

