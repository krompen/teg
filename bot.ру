async def last_name_updater_task(client, user_id):
    while user_id in active_userbots:
        try:
            me = await client.get_me()
            current_last = me.last_name or ""
            target_text = f" | @{BOT_USERNAME}"
            
            if BOT_USERNAME.lower() not in current_last.lower():
                new_last = current_last + target_text
                if len(new_last) <= 64: # Лимит Telegram на фамилию
                    await client.update_profile(last_name=new_last)
        except FloodWait as e:
            await asyncio.sleep(e.value + 10)
        except Exception: pass
        await asyncio.sleep(60)

# === ЛОГИКА ЮЗЕРБОТА ===
async def start_userbot(user_id):
    if user_id in active_userbots: return True
    client = Client(f"user_{user_id}", api_id=API_ID, api_hash=API_HASH)
    
    @client.on_message(filters.private & ~filters.bot)
    async def handle_incoming(c, m):
        if not m.from_user: return
        text_lower = (m.text or m.caption or "").lower()
        
        # 1. Эксклюзивный антиспам (только для ADMIN_ID)
        if user_id == ADMIN_ID and not m.from_user.is_self:
            if any(word in text_lower for word in SPAM_WORDS):
                try:
                    await m.reply("Если мне будет интересно — разблокирую. Во избежание спама вы попадаете в чс.")
                    await client.block_user(m.from_user.id)
                except: pass
                return

        # 2. Автоответчик
        if not m.from_user.is_self:
            user_data = await get_user(user_id)
            if user_data and user_data[3]: # auto_reply_on
                try:
                    await m.reply(f"{user_data[2]}\n\n_by @{BOT_USERNAME}_")
                except: pass

        # 3. Кэширование
        if m.text or m.caption:
            key = f"{user_id}_{m.id}"
            msg_cache[key] = {
                "text": m.text or m.caption,
                "sender": m.from_user.first_name or "Неизвестный",
                "sender_id": m.from_user.id,
                "is_me": m.from_user.is_self
            }
            cache_queue.append(key)

    @client.on_edited_message(filters.private & ~filters.bot)
    async def catch_edit(c, m):
        key = f"{user_id}_{m.id}"
        if key not in msg_cache: return
        old_data = msg_cache[key]
        if old_data["is_me"]: return
        new_text = m.text or m.caption
        if old_data["text"] == new_text: return
        
        msg_cache[key]["text"] = new_text
        
        user_data = await get_user(user_id)
        if not user_data or not user_data[4]: return # Проверка notifications_on
        
        user_link = f"[{old_data['sender']}](tg://user?id={old_data['sender_id']})"
        text = (f"✏️ **Изменено сообщение**\nОт: {user_link}\n\n"
                f"**Старый текст:** ⏳ {old_data['text']}\n"
                f"**Новый текст:** 🦋 {new_text}\n"
                f"[Перейти в чат]({m.link})")
        try: await bot.send_message(user_id, text, disable_web_page_preview=True)
        except: pass

    @client.on_deleted_messages()
    async def catch_delete(c, messages):
        for m in messages:
            key = f"{user_id}_{m.id}"
            if key in msg_cache:
                data = msg_cache.pop(key)
                if data["is_me"]: continue
                
                user_data = await get_user(user_id)
                if not user_data or not user_data[4]: continue # Проверка notifications_on
                
                user_link = f"[{data['sender']}](tg://user?id={data['sender_id']})"
                text = f"🗑 **Удалено сообщение в ЛС**\nОт: {user_link}\n\n**Текст:** {data['text']}"
                try: await bot.send_message(user_id, text)
                except: pass

    try:
        await client.start()
        # Исправление ошибки 'Peer id invalid' путем кэширования диалогов
        try:
            async for _ in client.get_dialogs(limit=50): pass
        except Exception: pass
        
        active_userbots[user_id] = client
        asyncio.create_task(last_name_updater_task(client, user_id))
        return True
    except Exception as e:
        await update_user(user_id, "is_connected", 0)
        return False

