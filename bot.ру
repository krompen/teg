# ==================== БАЗА ДАННЫХ ====================
_USER_FIELDS = {"is_banned", "premium", "premium_expires", "referrer_id"}
_BOT_FIELDS = {"bio", "working_hours", "spam_filter", "start_text", "btn_contact", "req_channel", "extended_info"}

def _connect():
    conn = sqlite3.connect(DB_FILE, timeout=10)
    conn.row_factory = sqlite3.Row
    return conn

def _init_db_sync():
    conn = _connect()
    c = conn.cursor()
    c.execute('''
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY, username TEXT, full_name TEXT,
            is_banned INTEGER DEFAULT 0, premium INTEGER DEFAULT 0,
            premium_expires INTEGER DEFAULT 0, registered_at INTEGER,
            referrer_id INTEGER DEFAULT 0
        )
    ''')
    c.execute('''
        CREATE TABLE IF NOT EXISTS child_bots (
            owner_id INTEGER PRIMARY KEY, bot_token TEXT UNIQUE,
            bio TEXT DEFAULT 'Информация отсутствует.', working_hours TEXT DEFAULT 'Не указаны',
            spam_filter INTEGER DEFAULT 0, msg_count INTEGER DEFAULT 0, last_broadcast INTEGER DEFAULT 0,
            start_text TEXT DEFAULT '👋 Добро пожаловать! Напишите ваше сообщение ниже.',
            btn_contact TEXT DEFAULT '✉️ Написать',
            req_channel TEXT DEFAULT '',
            extended_info TEXT DEFAULT 'Дополнительная информация не указана.'
        )
    ''')
    c.execute('CREATE TABLE IF NOT EXISTS clients (owner_id INTEGER, client_id INTEGER, PRIMARY KEY (owner_id, client_id))')
    c.execute('CREATE TABLE IF NOT EXISTS global_bans (user_id INTEGER PRIMARY KEY, banned_at INTEGER)')
    c.execute('CREATE TABLE IF NOT EXISTS mirror_bans (owner_id INTEGER, client_id INTEGER, banned_at INTEGER, PRIMARY KEY (owner_id, client_id))')
    c.execute('CREATE TABLE IF NOT EXISTS promo_claims (user_id INTEGER PRIMARY KEY, claimed_at INTEGER)')
    
    # Миграции
    user_cols = [col[1] for col in c.execute("PRAGMA table_info(users)").fetchall()]
    if 'referrer_id' not in user_cols: c.execute("ALTER TABLE users ADD COLUMN referrer_id INTEGER DEFAULT 0")
    
    bot_cols = [col[1] for col in c.execute("PRAGMA table_info(child_bots)").fetchall()]
    if 'start_text' not in bot_cols: c.execute("ALTER TABLE child_bots ADD COLUMN start_text TEXT DEFAULT '👋 Добро пожаловать! Напишите ваше сообщение ниже.'")
    if 'btn_contact' not in bot_cols: c.execute("ALTER TABLE child_bots ADD COLUMN btn_contact TEXT DEFAULT '✉️ Написать'")
    if 'req_channel' not in bot_cols: c.execute("ALTER TABLE child_bots ADD COLUMN req_channel TEXT DEFAULT ''")
    if 'extended_info' not in bot_cols: c.execute("ALTER TABLE child_bots ADD COLUMN extended_info TEXT DEFAULT 'Дополнительная информация не указана.'")
    conn.commit()
    conn.close()

async def init_db(): await asyncio.to_thread(_init_db_sync)

def _add_user_sync(user_id, username, full_name, referrer_id=0):
    conn = _connect()
    c = conn.cursor()
    c.execute("SELECT id FROM users WHERE id=?", (user_id,))
    if not c.fetchone():
        c.execute("INSERT INTO users (id, username, full_name, registered_at, referrer_id) VALUES (?, ?, ?, ?, ?)",
                  (user_id, username, full_name, int(time.time()), referrer_id))
        is_new = True
    else:
        c.execute("UPDATE users SET username=?, full_name=? WHERE id=?", (username, full_name, user_id))
        is_new = False
    conn.commit()
    conn.close()
    return is_new

async def db_add_user(user_id, username, full_name, referrer_id=0):
    return await asyncio.to_thread(_add_user_sync, user_id, username, full_name, referrer_id)

async def db_get_user(user_id):
    def _get():
        c = _connect()
        r = c.execute("SELECT * FROM users WHERE id=?", (user_id,)).fetchone()
        c.close()
        return r
    return await asyncio.to_thread(_get)

async def is_user_premium(user_row) -> bool:
    if not user_row or user_row["premium"] != 1: return False
    if user_row["premium_expires"] == 0 or user_row["premium_expires"] > int(time.time()): return True
    def _reset():
        c = _connect()
        c.execute("UPDATE users SET premium=0, premium_expires=0 WHERE id=?", (user_row["id"],))
        c.commit()
        c.close()
    await asyncio.to_thread(_reset)
    return False

async def db_apply_promo_if_available(user_id) -> bool:
    def _apply():
        conn = _connect()
        c = conn.cursor()
        c.execute("BEGIN IMMEDIATE")
        if c.execute("SELECT 1 FROM promo_claims WHERE user_id=?", (user_id,)).fetchone() or \
           c.execute("SELECT COUNT(*) FROM promo_claims").fetchone()[0] >= PROMO_LIMIT:
            conn.close()
            return False
        c.execute("UPDATE users SET premium=1, premium_expires=0 WHERE id=?", (user_id,))
        c.execute("INSERT INTO promo_claims (user_id, claimed_at) VALUES (?, ?)", (user_id, int(time.time())))
        conn.commit()
        conn.close()
        return True
    return await asyncio.to_thread(_apply)

async def db_update_child_bot(owner_id, field, value):
    def _upd():
        conn = _connect()
        conn.execute(f"UPDATE child_bots SET {field}=? WHERE owner_id=?", (value, owner_id))
        conn.commit()
        conn.close()
    if field in _BOT_FIELDS: await asyncio.to_thread(_upd)

async def db_get_child_bot(owner_id):
    def _get():
        c = _connect()
        r = c.execute("SELECT * FROM child_bots WHERE owner_id=?", (owner_id,)).fetchone()
        c.close()
        return r
    return await asyncio.to_thread(_get)

async def db_get_referral_count(user_id):
    def _count():
        c = _connect()
        # Защита от накрутки: считаем только тех рефералов, у которых реально запущен бот
        cnt = c.execute('''
            SELECT COUNT(*) FROM users u 
            JOIN child_bots b ON u.id = b.owner_id 
            WHERE u.referrer_id=?
        ''', (user_id,)).fetchone()[0]
        c.close()
        return cnt
    return await asyncio.to_thread(_count)

