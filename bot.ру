@bot.on_message(filters.command("start") & filters.private)
async def start_cmd(client, message):
    user_id = message.from_user.id
    await add_user(user_id)
    user_data = await get_user(user_id)
    status = user_data[0]
    
    if status == "banned": return await message.reply("❌ Вы заблокированы.")
    if status == "pending": return await message.reply("⏳ Ваша заявка на рассмотрении администратором.")
    
    if status == "new" and user_id != ADMIN_ID:
        if not await check_sub(client, user_id):
            return await message.reply("❗️ Для подачи заявки необходимо подписаться на канал!", reply_markup=sub_kb())
        return await generate_captcha(user_id, message)
        
    if user_id == ADMIN_ID and status == "new":
        await update_user(user_id, "status", "approved")

    is_connected = bool(user_data[1])
    text = f"👋 **Добро пожаловать, {message.from_user.first_name}**\n\n**Зеркало** - многофункциональный помощник в личных сообщениях."
    await message.reply(text, reply_markup=main_menu_kb(user_id == ADMIN_ID, is_connected))

