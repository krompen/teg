# === БАЗА ДАННЫХ ===
async def init_db():
    async with aiosqlite.connect("database.db") as db:
        await db.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                status TEXT DEFAULT 'new', -- 'new', 'pending', 'approved', 'banned'
                is_connected INTEGER DEFAULT 0,
                auto_reply_text TEXT DEFAULT 'Привет! Я сейчас занят, отвечу позже.',
                auto_reply_on INTEGER DEFAULT 0,
                notifications_on INTEGER DEFAULT 1
            )
        """)
        await db.commit()

async def get_user(user_id):
    async with aiosqlite.connect("database.db") as db:
        async with db.execute("SELECT status, is_connected, auto_reply_text, auto_reply_on, notifications_on FROM users WHERE user_id = ?", (user_id,)) as cursor:
            return await cursor.fetchone()

async def add_user(user_id):
    async with aiosqlite.connect("database.db") as db:
        await db.execute("INSERT OR IGNORE INTO users (user_id) VALUES (?)", (user_id,))
        await db.commit()

async def update_user(user_id, field, value):
    async with aiosqlite.connect("database.db") as db:
        await db.execute(f"UPDATE users SET {field} = ? WHERE user_id = ?", (value, user_id))
        await db.commit()

async def get_all_users_detailed():
    async with aiosqlite.connect("database.db") as db:
        async with db.execute("SELECT user_id, is_connected, auto_reply_on, status FROM users") as cursor:
            return await cursor.fetchall()

